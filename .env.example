# Notion - results database
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Resend - transactional email
RESEND_API_KEY=

# Email config
NOTIFICATION_EMAIL=           # your inbox - receives submission notifications
FROM_EMAIL=                   # sending address, must match your verified Resend domain (e.g. noreply@mail.yourdomain.com)
FROM_NAME=                    # your name - shown as sender on the results email

# Frontend
VITE_AUTHOR_NAME=             # your name - shown as wordmark on the welcome screen
VITE_CALENDAR_URL=            # your scheduling link - shown in app and results email
